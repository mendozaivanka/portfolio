# Copy to .env for local overrides (.env is git-ignored). In production, set these in the host's dashboard
# (Render: service → Environment). Everything is optional; the defaults reproduce the live site.

# ── Deployment ────────────────────────────────────────────────────────────────
# Public URL of the site. Canonical links, the sitemap and social previews use it. Change it when you
# move host or add a custom domain.
SITE_URL=https://portfolio-d79q.onrender.com

# Leave empty for a static site (any static host). Set to node | vercel | netlify | cloudflare only when a
# page must run on a server (e.g. live database reads), after `npm i @astrojs/<name>`.
DEPLOY_ADAPTER=

# ── Content source ────────────────────────────────────────────────────────────
# local = the files in src/data/ (default). http = a JSON API (see src/lib/data/sources/http.ts).
# A database source is one new file in src/lib/data/sources/ (see README → "Connecting a database").
DATA_SOURCE=local

# For DATA_SOURCE=http
DATA_API_URL=
# Secret: never commit a real value. Sent as "Authorization: Bearer <token>".
DATA_API_TOKEN=

