---
import TimplaLayout from "@/components/timpla/TimplaLayout.astro";
import BranchList from "@/components/timpla/BranchList";
import meta from "@/data/timpla/meta.json";
import { branchRows, TIER_TEXT } from "@/lib/timpla";
---

<TimplaLayout title="Cafés" current="cafes" description={`All ${meta.branches} specialty café branches in Metro Manila, with sources.`}>
  <section class="grid gap-5 pt-10">
    <div>
      <span class="label-mono">Directory</span>
      <h1 class="mt-1 font-serif text-[clamp(2.25rem,6vw,3.25rem)] leading-tight font-normal">{meta.shops} cafés, {meta.branches} branches</h1>
    </div>
    <dl class="grid max-w-3xl gap-2 text-sm sm:grid-cols-3">
      {
        (["acclaimed", "recognised", "indie"] as const).map((t) => (
          <div class="flex gap-2">
            <span class="tier-dot mt-1" data-tier={t} />
            <div>
              <dt class="font-semibold capitalize">{t} · {meta.tiers[t]}</dt>
              <dd class="m-0 text-muted-foreground">{TIER_TEXT[t]}</dd>
            </div>
          </div>
        ))
      }
    </dl>
    <BranchList client:load rows={branchRows} full />
  </section>
</TimplaLayout>
