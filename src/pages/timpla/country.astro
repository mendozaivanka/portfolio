---
import TimplaLayout from "@/components/timpla/TimplaLayout.astro";
import BeansNav from "@/components/tanim/BeansNav.astro";
import Cup from "@/components/tanim/Cup.astro";
import LineStrip from "@/components/tanim/LineStrip.astro";
import { getTanimImports, getTanimMeta, getTanimNational, getTanimProvinces } from "@/lib/data";
import { fmt, last } from "@/lib/tanim";

const [meta, nat, imports, provinces] = await Promise.all([getTanimMeta(), getTanimNational(), getTanimImports(), getTanimProvinces()]);
const y = meta.latestYear;
const tonnes = nat.production.all[y] ?? 0;
const ssr = last(nat.ssr)!, idr = last(nat.idr)!;
const vpCur = nat.valueOfProduction.current, vpCon = nat.valueOfProduction.constant2018;
const vpY = last(vpCur)![0];
const cpiPH = nat.cpi; const cpiY = Object.keys(cpiPH).sort().at(-1)!;
const impY = meta.importYears.at(-1)!; const imp = imports[impY];
const impUsd = Object.values(imp.byForm).reduce((s, f) => s + f.usd, 0);
const byOrigin = new Map<string, number>(); for (const f of imp.flows) byOrigin.set(f.name, (byOrigin.get(f.name) ?? 0) + f.usd);
const topOrigins = [...byOrigin.entries()].sort((a, b) => b[1] - a[1]).slice(0, 2);
const share = (v: string) => Math.round(((nat.production[v as "robusta"][y] ?? 0) / tonnes) * 100);
const skCpi = provinces.find((p) => p.name === "Sultan Kudarat")?.cpi[cpiY];
const fil = `Noong ${y}, ${fmt(tonnes)} tonelada ng berdeng kape ang naani sa buong bansa, nagkakahalaga ng ₱${((vpCur[vpY] ?? 0) / 1000).toFixed(1)} bilyon sa kasalukuyang presyo. Ayon sa PSA, ${ssr[1].toFixed(0)} sa bawat 100 tonelada ng kape ng bansa ang lokal na ani.`;
const en = `In ${y} the country grew ${fmt(tonnes)} tonnes of green coffee, worth ₱${((vpCur[vpY] ?? 0) / 1000).toFixed(1)} billion at current prices. By PSA's own ratio, ${ssr[1].toFixed(0)} in every 100 tonnes of the country's coffee supply was grown here.`;
const facts: [string, string, boolean][] = [
  ["Grown here", `${ssr[1].toFixed(0)} %`, true], ["Shipped in", `${(100 - ssr[1]).toFixed(0)} %`, false],
  ...topOrigins.map(([n, v]) => [`from ${n}`, `${Math.round((v / impUsd) * 100)} % of import value`, false] as [string, string, boolean]),
  ["Green coffee grown", `${fmt(tonnes)} t`, true], ["Robusta", `${share("robusta")} %`, false], ["Arabica", `${share("arabica")} %`, false], ["Excelsa and Liberica", `${share("excelsa") + share("liberica")} %`, false],
  [`Worth at ${vpY} prices`, `₱ ${((vpCur[vpY] ?? 0) / 1000).toFixed(1)} B`, true], ["Worth at 2018 prices", `₱ ${((vpCon[vpY] ?? 0) / 1000).toFixed(1)} B`, false],
  ["A ₱100 cup from 2018", `₱ ${cpiPH[cpiY].toFixed(0)}`, true], ...(skCpi ? [["Sultan Kudarat's cup", `₱ ${skCpi.toFixed(0)}`, false] as [string, string, boolean]] : []),
  ["Paid for imports", `USD ${(impUsd / 1e6).toFixed(0)} M`, true], [`Import dependency, ${idr[0]}`, `${idr[1].toFixed(0)} %`, false],
];
const ssrYears = [1988, 1995, 2000, 2005, 2010, 2015, 2020, Number(ssr[0])].filter((v, i, a) => a.indexOf(v) === i);
const ssrCups = ssrYears.map((yr) => ({ yr, v: nat.ssr[String(yr)] ?? 0, big: yr === Number(ssr[0]) }));
const cpiCups = Object.keys(cpiPH).sort().map((yr) => ({ yr, v: cpiPH[yr], big: yr === cpiY }));
const tableIds = ["0072E4EVCP1", "0012B5EVOP1", "0022E5ESSR0", "0012M4ACP22"];
const vpCurLabel = "₱" + ((vpCur[vpY] ?? 0) / 1000).toFixed(1) + " B in " + vpY;
const vpConLabel = "₱" + ((vpCon[vpY] ?? 0) / 1000).toFixed(1) + " B";
const series = (m: Record<string, number | null>, from = 0) => Object.entries(m).filter(([k, v]) => v != null && Number(k) >= from).map(([k, v]) => [Number(k), v as number] as [number, number]);
---

<TimplaLayout title="How much of the cup is ours" current="beans" description="The Philippines' coffee as a whole: how much of the cup is grown here, what the crop is worth and what a cup costs, from PSA's counts.">
  <BeansNav current="country" />
  <section class="grid gap-5 pt-10">
    <div><span class="label-mono">The country · {y}</span><h1 class="mt-1 font-serif text-[clamp(2.25rem,6vw,3.5rem)] leading-[1.04] font-normal tracking-tight text-balance">How much of the cup is <em class="text-primary-strong italic">ours</em></h1></div>
    <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-[0_12px_32px_-18px_rgba(40,25,15,.35)]">
      <div class="grid gap-6 p-6 md:grid-cols-2">
        <div class="grid content-start gap-5">
          <div class="flex items-center gap-5">
            <Cup fill={ssr[1] / 100} label={ssr[1].toFixed(0) + " percent of the cup grown here"} scale={1.7} />
            <div class="grid gap-1 leading-none"><span class="font-serif text-6xl tabular-nums">{ssr[1].toFixed(0)} %</span><span class="text-base">of the cup, grown here</span><span class="text-[13px] text-muted-foreground">the rest shipped in, mostly from {topOrigins.map(([n]) => n).join(" and ")}</span></div>
          </div>
          <blockquote class="m-0 border-l-[3px] border-primary pl-3.5 text-[15px] leading-relaxed"><p class="m-0">{fil}</p><p class="m-0 mt-1.5 text-muted-foreground">{en}</p></blockquote>
          <div class="flex flex-wrap gap-2"><a href="/timpla/shipped/" class="inline-flex min-h-10 items-center rounded-full border border-border bg-card px-4 text-sm font-medium">Shipped in →</a><a href="/timpla/data/#beans" class="inline-flex min-h-10 items-center rounded-full border border-border bg-card px-4 text-sm font-medium">The fine print</a></div>
          <div class="flex flex-wrap items-end gap-1">{[2,1,3,1,2,1,1,3,2,1,2,3,1,1,2,1,3,1,2,1].map((w) => <span class="h-5 opacity-55" style={"width:" + w + "px;background:var(--muted-foreground)"}></span>)}<span class="ml-2 font-mono text-[10.5px] text-muted-foreground">PSA OpenSTAT · {tableIds.join(" · ")} · retrieved {meta.retrievedAt}</span></div>
        </div>
        <div class="grid content-start gap-1 rounded-2xl border border-border bg-card px-5 py-4">
          <div class="flex items-end justify-between gap-2 border-b-2 border-primary-strong pb-2"><span class="font-serif text-3xl leading-none">Coffee facts</span><span class="label-mono">Serving: one country</span></div>
          <div class="py-1.5 text-[12.5px] text-muted-foreground">The Philippines, calendar {y} · Philippine Statistics Authority</div>
          {facts.map(([k, v, b]) => <div class:list={["flex justify-between gap-3 py-1.5 text-sm", b ? "border-b border-border font-semibold" : "border-b border-dashed border-border pl-3.5 text-muted-foreground"]}><span>{k}</span><span class="font-mono text-[13px] text-foreground">{v}</span></div>)}
          <div class="pt-2 text-[11.5px] leading-snug text-muted-foreground">"Grown here" is PSA's self-sufficiency ratio; import shares are by CIF value.</div>
        </div>
      </div>
    </div>
  </section>

  <section class="grid gap-4 pt-16">
    <div><span class="label-mono">Self-sufficiency, 1988 to {ssr[0]}</span><h2 class="mt-1 font-serif text-4xl font-normal">The cup used to overflow.</h2></div>
    <div class="flex flex-wrap items-end gap-x-5 gap-y-4 rounded-2xl border border-border bg-card p-5">
      {ssrCups.map((c) => (
        <figure class="m-0 grid justify-items-center gap-1.5">
          <Cup fill={c.v / 100} label={c.yr + ": " + c.v.toFixed(0) + " percent grown here"} scale={c.big ? 1.18 : 1} />
          <figcaption class="grid justify-items-center leading-tight"><span class:list={["font-serif tabular-nums", c.big ? "text-2xl" : "text-lg"]}>{c.v.toFixed(0)} %</span><span class="font-mono text-[10.5px] text-muted-foreground">{c.yr}</span></figcaption>
        </figure>
      ))}
    </div>
    <p class="max-w-[72ch] text-[13px] leading-relaxed text-muted-foreground">A cup for every fifth year; the coffee level is the share of the country's coffee supply grown here. In 1988 the country grew more than it used. PSA's self-sufficiency ratio, table 0022E5ESSR0.</p>
  </section>

  <section class="grid gap-4 pt-16">
    <div><span class="label-mono">Coffee CPI, 2018 to {cpiY}</span><h2 class="mt-1 font-serif text-4xl font-normal">A ₱100 cup, repriced each year.</h2></div>
    <div class="flex flex-wrap items-end gap-x-5 gap-y-4 rounded-2xl border border-border bg-card p-5">
      {cpiCups.map((c) => (
        <figure class="m-0 grid justify-items-center gap-1.5">
          <Cup fill={c.v / 150} label={c.yr + ": index " + c.v.toFixed(0)} scale={c.big ? 1.18 : 1} />
          <figcaption class="grid justify-items-center leading-tight"><span class:list={["font-serif tabular-nums", c.big ? "text-2xl" : "text-lg"]}>₱{c.v.toFixed(0)}</span><span class="font-mono text-[10.5px] text-muted-foreground">{c.yr}</span></figcaption>
        </figure>
      ))}
    </div>
    <p class="max-w-[72ch] text-[13px] leading-relaxed text-muted-foreground">Coffee and coffee substitutes, all-income households, yearly averages, 2018 = 100 (PSA 0012M4ACP22). {skCpi ? "Sultan Kudarat's cup is ₱" + skCpi.toFixed(0) + "." : ""}</p>
  </section>

  <section class="grid gap-4 pt-16">
    <div><span class="label-mono">Value of production, 2000 to {vpY}</span><h2 class="mt-1 font-serif text-4xl font-normal">What the crop was worth, two ways.</h2></div>
    <div class="grid gap-6 rounded-2xl border border-border bg-card p-5 md:grid-cols-2">
      <LineStrip title="At each year's prices" unit="₱ million, current prices" points={series(vpCur)} annotate={[{ year: Number(vpY), text: vpCurLabel }]} />
      <LineStrip title="At 2018 prices" unit="₱ million, constant 2018 prices" points={series(vpCon)} annotate={[{ year: Number(vpY), text: vpConLabel }]} />
    </div>
    <p class="max-w-[72ch] text-[13px] leading-relaxed text-muted-foreground">At each year's prices the crop nearly doubled in value in {vpY}; at constant 2018 prices it barely moved. Most of the jump is price, not beans. Two strips, two price bases, never one axis (PSA 0012B5EVOP1).</p>
  </section>

  <section class="grid gap-4 pt-16">
    <div><span class="label-mono">The ratios, year by year</span><h2 class="mt-1 font-serif text-4xl font-normal">Derived by PSA from its own counts.</h2></div>
    <div class="grid gap-6 rounded-2xl border border-border bg-card p-5 md:grid-cols-2">
      <LineStrip title="Self-sufficiency ratio" unit="%" points={series(nat.ssr)} max={130} fmt={(v) => v.toFixed(0) + "%"} />
      <LineStrip title="Import dependency ratio" unit="%" points={series(nat.idr)} max={80} fmt={(v) => v.toFixed(0) + "%"} />
    </div>
    <p class="max-w-[72ch] text-[13px] leading-relaxed text-muted-foreground">Self-sufficiency = production ÷ net supply (0022E5ESSR0). Import dependency = imports ÷ (production + imports − exports) (0032E5EIDR0). Printed as published; older bulletins carry since-revised values.</p>
  </section>
</TimplaLayout>
