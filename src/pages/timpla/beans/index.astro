---
import TimplaLayout from "@/components/timpla/TimplaLayout.astro";
import BeansNav from "@/components/tanim/BeansNav.astro";
import ProvinceAtlas from "@/components/tanim/ProvinceAtlas";
import { getTanimMeta, getTanimNational, getTanimProvinces } from "@/lib/data";
import { fmt, saying } from "@/lib/tanim";

const [meta, national, provinces] = await Promise.all([getTanimMeta(), getTanimNational(), getTanimProvinces()]);
const y = meta.latestYear;
const nat = national.production.all[y] ?? 0;
const top = [...provinces].sort((a, b) => (b.production.all[y] ?? 0) - (a.production.all[y] ?? 0))[0];
const topShare = top && nat ? (top.production.all[y] ?? 0) / nat : 0;
---

<TimplaLayout title="Beans: every province, counted" current="beans" description="Philippine coffee province by province, from the Philippine Statistics Authority's own counts: tonnes, hectares, trees and prices by variety since 2010.">
  <BeansNav current="provinces" />
  <section class="grid gap-5 pt-10">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="label-mono">Where the beans come from · PSA OpenSTAT · {meta.years[0]}–{y}</span>
        <h1 class="mt-1 max-w-[22ch] font-serif text-[clamp(2.25rem,6vw,3.5rem)] leading-[1.04] font-normal tracking-tight text-balance">
          Benguet is on every menu. <em class="text-primary-strong italic">{top?.name}</em> grows the coffee.
        </h1>
      </div>
      <dl class="grid grid-cols-3 gap-4">
        <div><dd class="m-0 font-serif text-4xl leading-none tabular-nums">{fmt(nat)} t</dd><dt class="label-mono mt-1">green coffee, {y}</dt></div>
        <div><dd class="m-0 font-serif text-4xl leading-none tabular-nums">{meta.reporting}</dd><dt class="label-mono mt-1">provinces reporting</dt></div>
        <div><dd class="m-0 font-serif text-4xl leading-none tabular-nums">{Math.round(topShare * 100)} %</dd><dt class="label-mono mt-1">from {top?.name}</dt></div>
      </dl>
    </div>
    <p class="max-w-[64ch] text-muted-foreground">
      Every province, every year since {meta.years[0]}, counted by the Philippine Statistics Authority: tonnes, hectares, bearing trees, yield and farmgate prices by variety, and the price of a cup at the till. {top?.name} alone grew {saying(topShare, "en")} of the country's {y} crop. Tap a province for its receipt.
    </p>
    <ProvinceAtlas client:visible src="/timpla/beans/atlas.json" />
  </section>
</TimplaLayout>
