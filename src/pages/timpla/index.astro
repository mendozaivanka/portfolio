---
import TimplaLayout from "@/components/timpla/TimplaLayout.astro";
import DotMap from "@/components/timpla/DotMap.astro";
import HarvestChart from "@/components/timpla/HarvestChart.astro";
import OpeningsChart from "@/components/timpla/OpeningsChart.astro";
import Receipt from "@/components/timpla/Receipt.astro";
import BranchList from "@/components/timpla/BranchList";
import meta from "@/data/timpla/meta.json";
import { branchRows, shops, shortBeans, whereOf } from "@/lib/timpla";

const featured = ["yardstick-coffee", "spotted-pig-cafe", "kubo-coffee"]
  .map((s) => ({ shop: shops.find((x) => x.slug === s), no: shops.findIndex((x) => x.slug === s) + 1 }))
  .filter((f) => f.shop);
---

<TimplaLayout title="Metro Manila's specialty coffee, mapped" current="home">
  <section class="flex flex-wrap items-center gap-12 pt-10 pb-2 sm:pt-14">
    <div class="flex flex-[1_1_420px] flex-col gap-5">
      <span class="label-mono">Metro Manila · specialty coffee · {meta.builtAt.slice(0, 4)}</span>
      <h1 class="font-serif text-[clamp(2.5rem,7vw,4rem)] leading-[1.02] font-normal tracking-tight text-balance">
        Every cup has a <em class="text-primary-strong italic">story</em>. Here are {meta.shops} of them.
      </h1>
      <p class="max-w-[46ch] text-lg leading-relaxed text-muted-foreground">
        A sourced map of the city's specialty cafés: who roasts for whom, where the beans grow, and when each place opened.
        No star ratings, just receipts.
      </p>
      <div class="flex flex-wrap gap-2.5">
        <a href="/timpla/map/" class="inline-flex min-h-11 items-center rounded-full bg-primary px-5 font-semibold text-primary-foreground">Explore the map</a>
        <a href="/timpla/cafes/" class="inline-flex min-h-11 items-center rounded-full border border-border bg-card px-5 font-medium">Browse cafés</a>
      </div>
      <dl class="mt-2 grid grid-cols-3 gap-3">
        <div><dd class="m-0 font-serif text-4xl leading-none">{meta.shops}</dd><dt class="label-mono mt-1">shops</dt></div>
        <div><dd class="m-0 font-serif text-4xl leading-none">{meta.branches}</dd><dt class="label-mono mt-1">branches</dt></div>
        <div><dd class="m-0 font-serif text-4xl leading-none">{meta.roasterLinks}</dd><dt class="label-mono mt-1">roaster links</dt></div>
      </dl>
    </div>
    <figure class="m-0 flex flex-[1_1_360px] flex-col gap-3">
      <a href="/timpla/map/" class="block rounded-2xl border border-border bg-card p-5 shadow-[0_12px_32px_-16px_rgba(176,74,111,.28)]" aria-label="Open the interactive map">
        <DotMap class="mx-auto max-w-[360px]" />
      </a>
      <figcaption class="flex flex-wrap gap-x-4 gap-y-1.5 text-[13px] text-muted-foreground">
        <span class="inline-flex items-center gap-1.5"><span class="tier-dot" data-tier="acclaimed"></span>acclaimed (2+ write-ups)</span>
        <span class="inline-flex items-center gap-1.5"><span class="tier-dot" data-tier="recognised"></span>recognised</span>
        <span class="inline-flex items-center gap-1.5"><span class="tier-dot" data-tier="indie"></span>indie</span>
      </figcaption>
    </figure>
  </section>

  <section aria-labelledby="branches-h" class="flex flex-wrap items-start gap-10 pt-16 sm:pt-20">
    <div class="flex flex-[1_1_280px] flex-col gap-3">
      <span class="label-mono">The directory</span>
      <h2 id="branches-h" class="font-serif text-4xl font-normal">{meta.branches} branches</h2>
      <p class="leading-relaxed text-muted-foreground">
        Every branch, sorted by how much has been written about it. The tier tells you about press coverage, not about the
        coffee.
      </p>
    </div>
    <div class="min-w-0 flex-[2_1_520px]">
      <BranchList client:visible rows={branchRows} limit={7} />
    </div>
  </section>

  <section aria-labelledby="beans-h" class="grid gap-5 pt-16 sm:pt-20">
    <div>
      <span class="label-mono">Where the beans come from</span>
      <h2 id="beans-h" class="mt-1 max-w-[24ch] font-serif text-4xl font-normal text-balance">
        Benguet is on every menu. <em class="text-primary-strong italic">Sultan Kudarat</em> grows the coffee.
      </h2>
    </div>
    <HarvestChart />
  </section>

  <section class="grid gap-6 pt-16 sm:pt-20">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <span class="label-mono">From the directory</span>
        <h2 class="mt-1 font-serif text-4xl font-normal">Three receipts</h2>
      </div>
      <a href="/timpla/cafes/" class="font-medium text-primary-strong">All {meta.shops} cafés →</a>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-7">
      {
        featured.map(({ shop, no }) => (
          <Receipt
            no={no}
            name={shop!.name}
            where={whereOf(shop!.branches[0])}
            since={shop!.since}
            beans={shortBeans(shop!.beans)}
            tier={shop!.tier}
            href={`/timpla/cafes/${shop!.slug}/`}
          />
        ))
      }
    </div>
  </section>

  <section class="flex flex-wrap items-end gap-8 pt-16 sm:pt-20">
    <div class="flex-[1_1_280px]">
      <span class="label-mono">Timeline</span>
      <h2 class="mt-1 mb-2 font-serif text-4xl font-normal">The wave came after 2022</h2>
      <p class="leading-relaxed text-muted-foreground">More specialty cafés opened in 2022–2024 than in the six years before.</p>
    </div>
    <div class="min-w-0 flex-[2_1_520px]"><OpeningsChart /></div>
  </section>
</TimplaLayout>
