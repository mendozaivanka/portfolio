---
import { Image } from "astro:assets";
import { BarChart3Icon, PenLineIcon, WorkflowIcon } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Clock from "@/components/Clock";
import CopyEmailButton from "@/components/CopyEmailButton";
import ProjectCard from "@/components/ProjectCard";
import PromptGardenCard from "@/components/PromptGardenCard";
import TimplaShowcase from "@/components/TimplaShowcase.astro";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Separator } from "@/components/ui/separator";
import me from "@/assets/me.jpeg";
import { formatDate } from "@/data/cv";
import { passRates, prompts, site, socials } from "@/data/site";
import { getCv, getProjects, getTools } from "@/lib/data";

const [cv, projects, { toolboxHighlights }] = await Promise.all([getCv(), getProjects(), getTools()]);

// Timpla gets its own section with the live map, so it isn't repeated in the work grid
const timpla = projects.find((p) => p.links.some((l) => l.href === "/timpla/"));
const featured = projects.filter((p) => p.featured && p !== timpla);
const currentRole = cv.experience.find((r) => r.end === null) ?? cv.experience[0];

const gists = [
  {
    Icon: PenLineIcon,
    tint: "bg-rosas-2",
    title: "Prompts are code",
    body: "Versioned, tested against real examples, and rewritten until they work on the edge cases too.",
  },
  {
    Icon: WorkflowIcon,
    tint: "bg-ube",
    title: "No-code, then code",
    body: "I build in n8n, Make and Zapier, and write Python or JS when no-code runs out.",
  },
  {
    Icon: BarChart3Icon,
    tint: "bg-pandan",
    title: "Evals or it didn't happen",
    body: "Every prompt gets an eval set before it goes anywhere near production.",
  },
];

const palette = [
  { name: "Kabibe", role: "shell", cls: "bg-background" },
  { name: "Rosas", role: "primary", cls: "bg-primary" },
  { name: "Mangga", role: "accent", cls: "bg-gold" },
  { name: "Ube", role: "support", cls: "bg-ube" },
  { name: "Pandan", role: "status", cls: "bg-pandan" },
];

const swatchClass: Record<string, string> = {
  rosas: "bg-rosas-2 text-foreground",
  ube: "bg-ube text-foreground",
  pandan: "bg-pandan text-foreground",
  mangga: "bg-mangga text-foreground",
  langit: "bg-langit text-foreground",
};
---

<Layout title={`${site.name} — ${site.role}`}>
  <!-- ───────── Hero ───────── -->
  <section class="pt-8 pb-2 sm:pt-14">
    <div class="grid gap-8 md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] md:gap-10">
      <div class="reveal flex flex-col gap-5">
        <span class="label-mono">AI · Automation · Prompt engineering</span>
        <h1 class="font-serif text-[clamp(2.25rem,7vw,3.5rem)] leading-[1.02] font-medium tracking-tight text-balance">
          Hi, I'm <em class="text-primary-strong italic">{site.name}</em>.
        </h1>
        <p class="font-serif text-xl leading-snug text-balance sm:text-[22px]">
          Prompts, agents and workflows that steer the busywork home.
        </p>
        <p class="max-w-[46ch] text-muted-foreground">
          <em class="text-foreground">Tala</em> is the morning star sailors steered by. I build the same kind of thing for
          teams: LLMs that classify, extract and draft, automations that connect the tools they already use, and evals that
          keep it all on course after it ships.
        </p>
        <ul class="grid list-none gap-2 p-0">
          {
            [
              ["Prompts", "Versioned, tested, rewritten until the edge cases pass."],
              ["Agents", "Useful on their own, with a human approving what matters."],
              ["Evals", "If I can't measure a prompt, I can't improve it."],
            ].map(([k, v]) => (
              <li class="grid grid-cols-[84px_minmax(0,1fr)] gap-2.5 border-t border-border pt-2 text-sm">
                <b class="label-mono pt-0.5">{k}</b>
                <span>{v}</span>
              </li>
            ))
          }
        </ul>
        <div class="flex flex-wrap gap-2">
          <Button asChild size="lg" variant="outline"><a href="/projects/">See my work</a></Button>
          <Button asChild size="lg" variant="outline"><a href="#contact">Get in touch</a></Button>
          {
            cv.profile.pdf && (
              <Button asChild size="lg" variant="outline">
                <a href={cv.profile.pdf} download>CV</a>
              </Button>
            )
          }
        </div>
      </div>

      <div class="reveal grid gap-4">
        <Card className="flex-row flex-wrap items-center gap-4 px-4">
          <div class="size-16 shrink-0 overflow-hidden rounded-full bg-rosas-2 ring-3 ring-primary ring-offset-3 ring-offset-card">
            <Image
              src={me}
              alt={`Portrait of ${site.name}`}
              width={128}
              height={128}
              densities={[1, 2]}
              loading="eager"
              class="size-full object-cover"
            />
          </div>
          <div class="grid min-w-0 gap-0.5">
            <span class="font-serif text-xl leading-tight font-semibold">{site.name}</span>
            <span class="flex flex-wrap items-center gap-1.5 text-[13px] text-muted-foreground">
              <span>{site.location}</span> · <Clock client:load timeZone={site.timeZone} />
            </span>
          </div>
          {
            site.available && (
              <Badge className="bg-pandan text-foreground sm:ml-auto">
                <span class="status-dot" aria-hidden="true" />
                Available for freelance
              </Badge>
            )
          }
        </Card>

        <PromptGardenCard client:visible prompts={prompts} passRates={passRates} />

        <Card>
          <CardHeader>
            <CardTitle className="label-mono font-sans font-medium">Palette · Tala Rosa</CardTitle>
          </CardHeader>
          <CardContent className="grid grid-cols-5 gap-2">
            {
              palette.map((s) => (
                <div class="grid min-w-0 gap-1 text-xs">
                  <i class:list={["block h-9 rounded-md border border-border", s.cls]} />
                  <em class="font-medium not-italic">{s.name}</em>
                  <span class="text-muted-foreground max-[420px]:hidden">{s.role}</span>
                </div>
              ))
            }
          </CardContent>
        </Card>
      </div>
    </div>
  </section>

  <!-- ───────── Gists ───────── -->
  <section class="reveal pt-10 sm:pt-14" id="gists">
    <div class="mb-5">
      <span class="label-mono">Extra gists</span>
      <h2 class="font-serif text-[clamp(1.625rem,3.4vw,2rem)] font-medium tracking-tight">How I work</h2>
    </div>
    <ul class="grid list-none gap-4 p-0 md:grid-cols-3">
      {
        gists.map(({ Icon, tint, title, body }) => (
          <li class="flex">
            <Card className="w-full">
              <CardHeader>
                <span class:list={["grid size-9 place-items-center rounded-md", tint]} aria-hidden="true">
                  <Icon size={18} />
                </span>
                <h3 class="pt-2 font-heading text-xl leading-snug font-medium">{title}</h3>
                <CardDescription>{body}</CardDescription>
              </CardHeader>
            </Card>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ───────── Selected work ───────── -->
  <section class="reveal pt-10 sm:pt-14" id="projects">
    <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="label-mono">Selected work · built on the job</span>
        <h2 class="font-serif text-[clamp(1.625rem,3.4vw,2rem)] font-medium tracking-tight">Things I've built</h2>
      </div>
      <Button asChild variant="outline" size="sm"><a href="/projects/">All projects <span aria-hidden="true">→</span></a></Button>
    </div>
    <!-- Six cards: 2×3 on tablets, 3×2 on desktop. auto-rows-fr makes every row the height of the tallest card -->
    <ul class="grid list-none auto-rows-fr gap-4 p-0 md:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((p) => (
          <li class="flex">
            <div class="w-full">
              <ProjectCard project={p} variant="link" />
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  {timpla && <TimplaShowcase project={timpla} />}

  <!-- ───────── Toolbox ───────── -->
  <section class="reveal pt-10 sm:pt-14" id="skills">
    <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="label-mono">Toolbox</span>
        <h2 class="font-serif text-[clamp(1.625rem,3.4vw,2rem)] font-medium tracking-tight">What I reach for</h2>
      </div>
      <Button asChild variant="outline" size="sm"><a href="/tools/">Full toolbox <span aria-hidden="true">→</span></a></Button>
    </div>
    <div class="flex flex-wrap gap-2">
      {
        toolboxHighlights.map((t) => (
          <Badge className={`h-auto px-3 py-1 text-[13px] ${swatchClass[t.swatch]}`}>{t.label}</Badge>
        ))
      }
    </div>
  </section>

  <!-- ───────── CV ───────── -->
  <section class="reveal pt-10 sm:pt-14" id="cv">
    <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="label-mono">Curriculum vitae</span>
        <h2 class="font-serif text-[clamp(1.625rem,3.4vw,2rem)] font-medium tracking-tight">Where I've been</h2>
      </div>
      <div class="flex flex-wrap gap-2">
        {cv.profile.pdf && <Button asChild variant="secondary" size="sm"><a href={cv.profile.pdf} download>Download PDF</a></Button>}
        <Button asChild variant="outline" size="sm"><a href="/cv/">Full CV <span aria-hidden="true">→</span></a></Button>
      </div>
    </div>
    <Card className="gap-0 py-0 md:grid md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <div class="grid content-start gap-3 border-b border-border p-5 md:border-r md:border-b-0 md:p-6">
        <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-muted-foreground">
          <span>{formatDate(currentRole.start)} → {formatDate(currentRole.end)}</span>
          {
            currentRole.end === null && (
              <Badge className="bg-pandan text-foreground">
                <span class="status-dot" aria-hidden="true" />
                now
              </Badge>
            )
          }
        </div>
        <h3 class="font-heading text-xl leading-snug font-medium">{currentRole.title}</h3>
        <p class="text-muted-foreground">{currentRole.company} · {currentRole.location}</p>
        <p class="text-sm text-muted-foreground">{currentRole.bullets[0]}</p>
        <p class="text-sm">
          Before that: {cv.experience.length - 1} roles at {cv.experience[1]?.company}, and a
          <span class="text-gold-ink"> {cv.education[0].honours.split(" · ")[0]}</span> B.S. in IT from {cv.education[0].school}.
        </p>
      </div>
      <ul class="grid list-none grid-cols-2 gap-px bg-border p-0">
        {
          cv.impact.map((m) => (
            <li class="grid content-start gap-1 bg-card p-5 md:p-6">
              <span class="font-serif text-3xl leading-none tabular-nums sm:text-4xl">{m.value}</span>
              <span class="text-sm font-medium">{m.label}</span>
              <span class="text-xs text-muted-foreground">{m.note}</span>
            </li>
          ))
        }
      </ul>
    </Card>
  </section>

  <!-- ───────── About + socials ───────── -->
  <section class="reveal pt-10 sm:pt-14" id="about">
    <div class="grid gap-4 sm:grid-cols-2">
      <Card>
        <CardHeader>
          <span class="label-mono">About me</span>
          <CardTitle className="text-xl">A bit lazy, in the useful way</CardTitle>
        </CardHeader>
        <CardContent className="grid gap-3 text-muted-foreground">
          <p>
            Anything I've done three times, I want a machine to do. That turned into a career designing how people and AI
            work together.
          </p>
          <p>
            Away from the keyboard: coffee, food, long walks, and a growing pile of half-watched shows. (I also
            touch grass, promise.)
          </p>
        </CardContent>
      </Card>

      <Card className="gap-0" id="social">
        <CardHeader className="pb-4">
          <span class="label-mono">Social dump</span>
          <CardTitle className="text-xl">Find me elsewhere</CardTitle>
        </CardHeader>
        <Separator />
        <ul class="list-none p-0">
          {
            socials.map((s) => (
              <li class="border-t border-border first:border-t-0">
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  class="flex items-center justify-between gap-3 px-4 py-3 transition-colors hover:bg-muted"
                >
                  <span class="font-medium">{s.name}</span>
                  <span class="text-right text-[13px] text-muted-foreground">{s.note} <span aria-hidden="true">↗</span></span>
                </a>
              </li>
            ))
          }
        </ul>
      </Card>
    </div>
  </section>

  <!-- ───────── Contact ───────── -->
  <section class="reveal pt-10 sm:pt-14" id="contact">
    <Card className="relative gap-6 overflow-hidden px-5 pt-9 pb-6 sm:grid sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:px-8 sm:pt-10 sm:pb-8">
      <div class="stripe absolute inset-x-0 top-0 h-1.5!" aria-hidden="true"></div>
      <div>
        <span class="label-mono">Want to connect?</span>
        <h2 class="font-serif text-[clamp(1.625rem,3.4vw,2.125rem)] font-medium tracking-tight text-balance">
          Got busywork that needs automating?
        </h2>
        <p class="mt-1.5 text-muted-foreground">
          Or a prompt that isn't behaving. Email is the easiest way to reach me, and I usually reply within a day.
        </p>
      </div>
      <div class="flex flex-wrap gap-2 *:max-sm:flex-1">
        <Button asChild size="lg"><a href={`mailto:${site.email}`}>Email me</a></Button>
        <CopyEmailButton client:idle email={site.email} />
      </div>
    </Card>
  </section>
</Layout>
