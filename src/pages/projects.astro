---
import Layout from "@/layouts/Layout.astro";
import ProjectGrid from "@/components/ProjectGrid";
import { site } from "@/data/site";
import { projects } from "@/data/projects";

const years = projects.map((p) => p.year);
const range = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : "";
---

<Layout title={`Projects — ${site.name}`} description={`Agents, automations and prompt tooling built by ${site.name}.`}>
  <section class="reveal grid max-w-[640px] gap-3 pt-8 pb-6 sm:pt-14 sm:pb-8">
    <span class="label-mono">Projects{range && ` · ${range}`}</span>
    <h1 class="font-serif text-[clamp(2.375rem,5.5vw,3.25rem)] leading-[1.05] font-medium tracking-tight">
      Things I've <em class="text-primary-strong italic">built</em>
    </h1>
    <p class="text-muted-foreground">
      Tools that make prompts, agents and workflows behave, mostly so that nobody has to do the same task twice.
    </p>
  </section>

  <section class="reveal">
    <ProjectGrid client:load projects={projects} headingLevel="h2" />
  </section>
</Layout>
