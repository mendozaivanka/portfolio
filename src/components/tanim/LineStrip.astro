---
/** One PSA series over a span of years: a line with yearly dots, hairline grid, a few direct labels. One unit, one axis. */
type Pt = [number, number];
type Props = { title: string; unit: string; points: Pt[]; min?: number; max?: number; x0?: number; x1?: number; labelEvery?: number; annotate?: { year: number; text: string; anchor?: "start" | "end" }[]; fmt?: (v: number) => string };
const { title, unit, points, min, max, x0, x1, labelEvery = 5, annotate = [], fmt = (v: number) => v.toLocaleString("en", { maximumFractionDigits: 0 }) } = Astro.props;
const ys = points.map((p) => p[1]);
const y0 = min ?? 0, y1 = max ?? Math.max(...ys) * 1.15;
const xa = x0 ?? Math.min(...points.map((p) => p[0])), xb = x1 ?? Math.max(...points.map((p) => p[0]));
const W = 420, H = 110, ml = 44, mr = 10, mt = 10, mb = 20;
const X = (yr: number) => ml + ((yr - xa) / Math.max(1, xb - xa)) * (W - ml - mr);
const Y = (v: number) => mt + (1 - (v - y0) / (y1 - y0)) * (H - mt - mb);
const poly = points.map(([a, b]) => `${X(a).toFixed(1)} ${Y(b).toFixed(1)}`).join(" ");
const years = Array.from({ length: xb - xa + 1 }, (_, i) => xa + i).filter((yr) => yr % labelEvery === 0 || (yr === xb && xb % labelEvery >= 3));
---

<figure class="m-0 grid gap-0.5">
  <figcaption class="flex justify-between gap-2 text-[12.5px]"><span class="font-semibold">{title}</span><span class="font-mono text-muted-foreground">{unit}</span></figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} class="block h-auto w-full overflow-visible" role="img" aria-label={`${title}, ${xa} to ${xb}, ${unit}`}>
    {[y0, (y0 + y1) / 2, y1].map((g) => (<><line x1={ml} x2={W - mr} y1={Y(g)} y2={Y(g)} stroke="var(--border)" stroke-width="1"></line><text x={ml - 5} y={Y(g) + 3.5} text-anchor="end" font-family="DM Mono, monospace" font-size="9" fill="var(--muted-foreground)">{fmt(g)}</text></>))}
    {years.map((yr) => (<text x={X(yr)} y={H - 4} text-anchor="middle" font-family="DM Mono, monospace" font-size="9" fill="var(--muted-foreground)">{yr}</text>))}
    <polyline points={poly} fill="none" stroke="var(--foreground)" stroke-width="2"></polyline>
    {points.map(([a, b]) => (<circle cx={X(a)} cy={Y(b)} r="2.6" fill="var(--foreground)"><title>{a}: {fmt(b)}</title></circle>))}
    {annotate.map((n) => { const p = points.find((q) => q[0] === n.year); return p ? <text x={X(n.year)} y={Y(p[1]) - 8} text-anchor={n.anchor ?? "end"} font-family="Figtree, sans-serif" font-size="10.5" font-weight="600" fill="var(--foreground)">{n.text}</text> : null; })}
  </svg>
</figure>
