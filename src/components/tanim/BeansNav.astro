---
/** The Beans chapter's own three tabs, under the Timpla header. */
type Props = { current: "provinces" | "country" | "tour" };
const { current } = Astro.props;
const tabs = [
  { id: "provinces", label: "Every province", href: "/timpla/beans/" },
  { id: "country", label: "The country", href: "/timpla/country/" },
  { id: "tour", label: "Six provinces", href: "/timpla/tour/" },
];
---

<nav aria-label="Beans chapter" class="flex flex-wrap items-center gap-2 pt-6">
  <span class="label-mono mr-2">Beans</span>
  {tabs.map((t) => (
    <a href={t.href} aria-current={current === t.id ? "page" : undefined}
      class="inline-flex min-h-9 items-center rounded-full border border-border bg-card px-3.5 text-[13.5px] font-medium hover:bg-muted aria-[current=page]:border-primary aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground">{t.label}</a>
  ))}
</nav>
