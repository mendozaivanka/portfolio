---
import { site } from "@/data/site";

const year = new Date().getFullYear();
const links = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "/projects/" },
  { label: "Tools", href: "/tools/" },
  { label: "CV", href: "/cv/" },
  { label: "Tala", href: "/tala/" },
  { label: "About", href: "/#about" },
  { label: "Contact", href: "/#contact" },
];
---

<footer class="mt-18 border-t border-border print:hidden">
  <div
    class="container-site flex flex-col items-start justify-between gap-3 pt-6 pb-[max(2rem,env(safe-area-inset-bottom,0px))] sm:flex-row sm:items-center"
  >
    <nav class="flex flex-wrap gap-x-4 gap-y-1" aria-label="Footer">
      {
        links.map((l) => (
          <a href={l.href} class="py-1 text-sm text-muted-foreground transition-colors hover:text-foreground">
            {l.label}
          </a>
        ))
      }
    </nav>
    <small class="text-[13px] text-muted-foreground">© {year} {site.name} · set in Tala Rosa · hosted on Render</small>
  </div>
</footer>
