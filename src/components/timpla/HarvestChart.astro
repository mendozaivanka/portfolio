---
// Dumbbell: share of Manila roasters' Philippine bean listings vs share of the national Arabica harvest.
import provenance from "@/data/timpla/provenance.json";
import meta from "@/data/timpla/meta.json";

const MAX = 60; // % axis max
const pos = (v: number) => `${(v / MAX) * 100}%`;
const rows = [...provenance].sort((a, b) => b.menuShare - a.menuShare);
---

<figure class="m-0 grid gap-4 rounded-2xl border border-border bg-card p-5 sm:p-6">
  <figcaption class="flex flex-wrap items-center justify-between gap-3">
    <span class="text-[15px] font-semibold">Share of Manila bean listings vs share of the national Arabica harvest</span>
    <span class="flex flex-wrap gap-4 text-[13px] text-muted-foreground">
      <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-full" style="background: var(--tier-recognised)"></span>on Manila menus</span>
      <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-full" style="background: var(--harvest)"></span>Arabica harvest (PSA 2025)</span>
    </span>
  </figcaption>
  <div class="grid gap-3" aria-hidden="true">
    {
      rows.map((r) => {
        const lo = Math.min(r.menuShare, r.harvestShare);
        const hi = Math.max(r.menuShare, r.harvestShare);
        return (
          <div class="grid grid-cols-[minmax(0,130px)_1fr] items-center gap-3 max-sm:grid-cols-1 max-sm:gap-1">
            <span class="text-sm">{r.province}</span>
            <div class="relative h-6">
              <span class="absolute inset-x-0 top-[11px] h-0.5 bg-muted" />
              <span class="absolute top-[10px] h-1 rounded-full bg-rosas-2" style={`left:${pos(lo)};width:${pos(hi - lo)}`} />
              <span
                class="absolute top-[5px] size-3.5 -translate-x-1/2 rounded-full border-2 border-card"
                style={`left:${pos(r.menuShare)};background:var(--tier-recognised)`}
              />
              <span
                class="absolute top-[5px] size-3.5 -translate-x-1/2 rounded-full border-2 border-card"
                style={`left:${pos(r.harvestShare)};background:var(--harvest)`}
              />
            </div>
          </div>
        );
      })
    }
    <div class="grid grid-cols-[minmax(0,130px)_1fr] gap-3 font-mono text-[11px] text-muted-foreground max-sm:grid-cols-1">
      <span class="max-sm:hidden"></span>
      <span class="flex justify-between"><span>0%</span><span>20%</span><span>40%</span><span>60%</span></span>
    </div>
  </div>
  <details class="text-sm">
    <summary class="cursor-pointer text-muted-foreground">Show the numbers</summary>
    <table class="mt-3 w-full border-collapse text-left text-[13px]">
      <thead>
        <tr class="border-b border-border"><th class="py-1.5 font-medium">Province</th><th class="py-1.5 font-medium">Manila listings</th><th class="py-1.5 font-medium">Share</th><th class="py-1.5 font-medium">Arabica harvest</th><th class="py-1.5 font-medium">Share</th></tr>
      </thead>
      <tbody class="font-mono">
        {
          rows.map((r) => (
            <tr class="border-b border-border/60">
              <td class="py-1.5 font-sans">{r.province}</td>
              <td>{r.listings}</td>
              <td>{r.menuShare}%</td>
              <td>{r.arabicaTonnes.toLocaleString("en")} t</td>
              <td>{r.harvestShare}%</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
  <p class="m-0 text-[13px] text-muted-foreground">
    Menus: {meta.listingTotal} Philippine-origin bean listings with a named province, from Manila roasters' own shops. Harvest:
    Arabica green coffee beans by province, Philippine Statistics Authority, 2025 ({meta.arabicaTotal.toLocaleString("en")} t
    nationally). Counting all coffee, Sultan Kudarat's share is even larger, because it also grows most of the country's Robusta.
  </p>
</figure>
