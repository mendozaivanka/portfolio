---
import Layout from "@/layouts/Layout.astro";
import meta from "@/data/timpla/meta.json";

type Props = { title: string; description?: string; current?: "home" | "map" | "cafes" | "data" };
const { title, description, current } = Astro.props;

const links = [
  { id: "home", label: "Overview", href: "/timpla/" },
  { id: "map", label: "Map", href: "/timpla/map/" },
  { id: "cafes", label: "Cafés", href: "/timpla/cafes/" },
  { id: "data", label: "About the data", href: "/timpla/data/" },
];
---

<Layout
  title={`${title} · Timpla`}
  description={description ??
    `Timpla maps ${meta.shops} specialty cafés in Metro Manila: who roasts for whom, where the beans grow, and when each place opened.`}
>
  <nav
    aria-label="Timpla"
    class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 border-b border-border pb-4 print:hidden"
  >
    <a href="/timpla/" class="flex items-center gap-2 font-serif text-2xl font-medium">
      <svg width="26" height="26" viewBox="0 0 52 52" aria-hidden="true">
        <circle cx="26" cy="26" r="24" fill="var(--rosas-5)"></circle>
        <polygon points="26,9 29.5,22.5 43,26 29.5,29.5 26,43 22.5,29.5 9,26 22.5,22.5" fill="var(--gold)"></polygon>
      </svg>
      Timpla
    </a>
    <ul class="flex list-none flex-wrap gap-x-5 gap-y-1 p-0 text-[15px] font-medium text-muted-foreground">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={current === l.id ? "page" : undefined}
              class="inline-flex min-h-11 items-center hover:text-foreground aria-[current=page]:text-foreground aria-[current=page]:underline aria-[current=page]:decoration-primary-strong aria-[current=page]:underline-offset-8"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <span class="ml-auto font-mono text-xs text-muted-foreground">a side project · data as of {meta.builtAt}</span>
  </nav>
  <slot />
  <p class="mt-16 border-t border-border pt-5 text-[13px] text-muted-foreground">
    Map data © <a class="underline underline-offset-4" href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a> (ODbL) ·
    harvest data: Philippine Statistics Authority · editorial sources cited per café ·
    no Google or Foursquare ratings, by design.
  </p>
</Layout>
